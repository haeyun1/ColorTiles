<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/Resources/Styles/Common.uss?fileID=7433441132597879392&amp;guid=61aaf5d390c5e4ca1a73ce9007310999&amp;type=3#Common" />
    <ui:VisualElement name="Root" class="root">
        <ui:Label tabindex="-1" text="Color Tiles" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Title" style="top: -15%;" />
        <ui:Label tabindex="-1" text="Top&#10;Score" parse-escape-sequences="true" display-tooltip-when-elided="true" style="position: absolute; top: 30%; left: 2.6%; font-size: 30px; color: rgb(0, 0, 0); -unity-font-definition: resource(&apos;Fonts/Electronic Highway Sign&apos;);" />
        <ui:Label tabindex="-1" text="0" parse-escape-sequences="true" display-tooltip-when-elided="true" name="TopScore" style="position: absolute; left: 5.2%; font-size: 30px; align-items: center; width: 0; height: 0; top: 36%; -unity-font-definition: resource(&apos;Fonts/Electronic Highway Sign&apos;);" />
        <ui:VisualElement name="Btns" class="group" style="top: 0; right: 0; left: 0; bottom: 0;">
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="HelpBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_announcement&apos;); top: 5%;" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="QuitBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_close&apos;); top: 5%;" />
            <ui:Button text="Play" parse-escape-sequences="true" display-tooltip-when-elided="true" name="PlayBtn" class="text-btn" style="bottom: 25%; display: flex;" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="RankBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_cup&apos;); top: 18%; left: 2.5%;" />
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResetBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_locked&apos;); top: 85%; left: 2.5%;" />
        </ui:VisualElement>
        <ui:VisualElement name="Overlay" style="background-color: rgba(0, 0, 0, 0.39); position: absolute; width: 100%; height: 100%; align-items: center; align-self: stretch; justify-content: center; transform-origin: center; top: 0;">
            <ui:VisualElement name="HelpPopUp" class="pop-up">
                <ui:VisualElement name="Imgs" class="group">
                    <ui:VisualElement name="HelpImg" class="group" style="background-image: url(&quot;project://database/Assets/Images/Help.png?fileID=2800000&amp;guid=4568f70280f4946b682a7a096013225e&amp;type=3#Help&quot;);" />
                    <ui:VisualElement name="Highlight1" style="background-color: rgba(255, 229, 0, 0.78); align-items: center; align-self: center; position: absolute;" />
                    <ui:VisualElement name="Highlight2" style="background-color: rgba(255, 229, 0, 0.78); align-items: center; align-self: center; position: absolute;" />
                </ui:VisualElement>
                <ui:Label tabindex="-1" text="Click on a blank space.&#10;If the color matches the nearest neighboring tiles,&#10;vertically or horizontally,&#10;from the clicked space, you get the matching tiles." parse-escape-sequences="true" display-tooltip-when-elided="true" name="HelpText" />
                <ui:Label tabindex="-1" text="You get 1 point for each tile.&#10;You have 120 seconds to play.&#10;Each incorrect click reduces your time by 10 seconds." parse-escape-sequences="true" display-tooltip-when-elided="true" name="HelpText" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_minus&apos;);" />
            </ui:VisualElement>
            <ui:VisualElement name="RankPopUp" class="pop-up">
                <ui:VisualElement name="Imgs" class="group" />
                <ui:Label tabindex="-1" text="Ranking" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Text" style="font-size: 80%; position: absolute; top: 5%;" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_minus&apos;);" />
                <ui:ScrollView mouse-wheel-scroll-size="5" touch-scroll-type="Clamped" vertical-scroller-visibility="Hidden" style="position: relative; width: 100%; height: 70%; top: 7%; bottom: auto;" />
            </ui:VisualElement>
            <ui:VisualElement name="StartPopUp" class="pop-up" style="width: 50%; height: 30%;">
                <ui:VisualElement name="Imgs" class="group" />
                <ui:VisualElement name="Information" style="height: 40%; top: 15%; width: 80%; justify-content: space-between;">
                    <ui:TextField picking-mode="Ignore" label="Name" name="StudentName" mask-character=" " style="-unity-font-style: bold; font-size: 30px; -unity-text-align: upper-left; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);" />
                    <ui:TextField picking-mode="Ignore" label="phone" name="StudentPhoneNum" mask-character=" " class="korean-text" style="justify-content: space-between; -unity-font-style: bold; font-size: 30px; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);" />
                </ui:VisualElement>
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_minus&apos;); left: 92%; bottom: 82%; width: 50px; height: 50px;" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="StartBtn" text="Start" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_minus&apos;); -unity-font: resource(&apos;Fonts/Electronic Highway Sign&apos;); -unity-font-definition: initial; font-size: 20px; -unity-font-style: bold; width: 100px; position: relative; height: 100px; top: 5%; color: rgb(255, 0, 0);" />
            </ui:VisualElement>
            <ui:VisualElement name="WarningPopUp" class="pop-up" style="width: 50%; height: 30%; font-size: 50px; -unity-font: initial; -unity-font-definition: initial;">
                <ui:VisualElement name="Imgs" class="group" />
                <ui:Label tabindex="-1" text="이름을 입력해 주세요." parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="color: rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);" />
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_minus&apos;); left: 92%; bottom: 82%; width: 50px; height: 50px;" />
            </ui:VisualElement>
            <ui:VisualElement name="ResetPopUp" class="pop-up" style="width: 50%; height: 30%; font-size: 50px; -unity-font: initial; -unity-font-definition: initial;">
                <ui:VisualElement name="Imgs" class="group" />
                <ui:Label tabindex="-1" text="비밀번호를 입력해 주세요." parse-escape-sequences="true" display-tooltip-when-elided="true" name="Label" style="color: rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); top: 10%;" />
                <ui:VisualElement name="PWContainer" style="flex-grow: 0; width: 60%; height: 20%; flex-direction: row; justify-content: space-between; top: -10%;">
                    <ui:TextField password="true" tabindex="-1" style="width: 60%; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-font-style: bold;" />
                    <ui:Button name="ApplyBtn" style="width: 20%;" />
                </ui:VisualElement>
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="BackBtn" class="img-btn" style="background-image: resource(&apos;Icons/Border/ic_minus&apos;); left: 92%; bottom: 82%; width: 50px; height: 50px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
